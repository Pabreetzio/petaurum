<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Petaurum.Windows</RootNamespace>
    <AssemblyName>Petaurum</AssemblyName>
    <Product>Petaurum</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- IEEE MAC prefix registry; regenerate with tools/Update-OuiList.ps1. -->
    <EmbeddedResource Include="Discovery\oui.txt" LogicalName="Petaurum.Windows.Discovery.oui.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/System.Drawing out of global usings so they don't clash with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
