<Page x:Class="Petaurum.Windows.Pages.RouterPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Petaurum.Windows.Pages"
      xmlns:router="using:Petaurum.Windows.Router"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- Label/value rows, as Settings shows them. -->
        <DataTemplate x:Key="FieldTemplate" x:DataType="router:RouterField">
            <toolkit:SettingsCard Header="{x:Bind Label}" MinHeight="48">
                <TextBlock Text="{x:Bind Value}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="480"
                           IsTextSelectionEnabled="True" />
            </toolkit:SettingsCard>
        </DataTemplate>

        <local:RouterBlockTemplateSelector x:Key="BlockTemplates">
            <local:RouterBlockTemplateSelector.FieldsTemplate>
                <DataTemplate x:DataType="router:RouterBlock">
                    <ItemsRepeater ItemsSource="{x:Bind Fields}" ItemTemplate="{StaticResource FieldTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </DataTemplate>
            </local:RouterBlockTemplateSelector.FieldsTemplate>

            <!-- One expander per record, such as each device on the device list. -->
            <local:RouterBlockTemplateSelector.RecordsTemplate>
                <DataTemplate x:DataType="router:RouterBlock">
                    <ItemsRepeater ItemsSource="{x:Bind Records}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="router:RouterRecord">
                                <toolkit:SettingsExpander Header="{x:Bind Title}" Description="{x:Bind Subtitle}"
                                                          ItemsSource="{x:Bind Fields}"
                                                          ItemTemplate="{StaticResource FieldTemplate}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </DataTemplate>
            </local:RouterBlockTemplateSelector.RecordsTemplate>

            <local:RouterBlockTemplateSelector.TableTemplate>
                <DataTemplate x:DataType="router:RouterBlock">
                    <local:RouterTableView Block="{x:Bind}" />
                </DataTemplate>
            </local:RouterBlockTemplateSelector.TableTemplate>
        </local:RouterBlockTemplateSelector>
    </Page.Resources>

    <!-- Like Settings: content left-aligned in a column up to 1000 wide. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,8,36,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1000" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind Page.Title}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{x:Bind Page.StatusText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Page.IsRefreshing, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" Click="Refresh_Click" IsEnabled="{x:Bind local:RouterPageView.Not(Page.IsRefreshing), Mode=OneWay}"
                    ToolTipService.ToolTip="Read this page from the router again (F5)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Open in browser" Click="OpenInBrowser_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Forget access code" Click="ForgetAccessCode_Click"
                                        IsEnabled="{x:Bind Router.HasAccessCode, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind Page.IsWaitingForAccessCode, Mode=OneWay}"
                     Title="This page needs the router's device access code"
                     Message="It's printed on the label on the router. Petaurum keeps it in Windows Credential Locker.">
                <InfoBar.ActionButton>
                    <Button Content="Enter access code" Click="EnterAccessCode_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind Page.HasError, Mode=OneWay}"
                     Title="Couldn't refresh this page"
                     Message="{x:Bind Page.Error, Mode=OneWay}" />
        </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="1" Padding="36,0,36,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <ItemsRepeater ItemsSource="{x:Bind Page.Sections, Mode=OneWay}" Margin="0,0,0,36">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="router:RouterSection">
                        <StackPanel Spacing="4" Margin="0,0,0,24">
                            <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="1,0,0,4"
                                       Visibility="{x:Bind local:RouterPageView.VisibleIf(Heading)}" />
                            <ItemsRepeater ItemsSource="{x:Bind Blocks}" ItemTemplate="{StaticResource BlockTemplates}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
