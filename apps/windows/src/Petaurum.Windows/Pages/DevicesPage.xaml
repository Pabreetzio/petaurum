<Page x:Class="Petaurum.Windows.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Petaurum.Windows.Pages"
      xmlns:discovery="using:Petaurum.Windows.Discovery"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Required">

    <!-- Laid out like a Windows Settings page: a title, then a column of cards on the Mica background. -->
    <Grid Padding="36,8,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <Grid Grid.Row="1" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" Click="ScanNow_Click"
                    ToolTipService.ToolTip="Scan the network again (F5)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Scan now" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="-36,0,-36,0" Padding="36,0,36,0">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}" MaxWidth="1000" Margin="0,0,0,36">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="discovery:Device">
                        <toolkit:SettingsCard Header="{x:Bind DisplayName}"
                                              Description="{x:Bind VendorText}"
                                              IsClickEnabled="True" Click="Open_Click" Tag="{x:Bind WebUri}"
                                              AutomationProperties.Name="{x:Bind DisplayName}"
                                              ToolTipService.ToolTip="{x:Bind WebUri}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{x:Bind local:DevicesPage.GlyphFor(IsThisComputer)}" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                            <toolkit:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open in browser" Tag="{x:Bind WebUri}" Click="Open_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy IP address" Tag="{x:Bind IpText}" Click="Copy_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy MAC address" Tag="{x:Bind MacText}" Click="Copy_Click"
                                                    IsEnabled="{x:Bind local:DevicesPage.HasValue(MacText)}" />
                                </MenuFlyout>
                            </toolkit:SettingsCard.ContextFlyout>

                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind IpText}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind MacText}" HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind local:DevicesPage.VisibleIf(MacText)}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
