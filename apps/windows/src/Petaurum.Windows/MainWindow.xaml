<Window x:Class="Petaurum.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Petaurum"
        Width="900" Height="560" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Scan now" Padding="14,4"
                    IsEnabled="{Binding CanScan}" Click="ScanNow_Click" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#555" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEE" BorderBrush="#DDD"
                  RowHeight="26" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Vendor" Binding="{Binding VendorText}" Width="160" />
                <DataGridTemplateColumn Header="IP address" SortMemberPath="SortKey" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="{Binding WebUri}" RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="{Binding IpText, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="MAC address" Binding="{Binding MacText}" Width="170"
                                    FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
